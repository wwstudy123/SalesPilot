# 复制为 .env 后按需修改；.env 已被 .gitignore 忽略

# ===== Python Internal API =====
AGENTKIT_INTERNAL_API_HOST=127.0.0.1
AGENTKIT_INTERNAL_API_PORT=8000
# 留空表示不鉴权；生产环境务必设置，并与前端代理保持一致
AGENTKIT_INTERNAL_API_TOKEN=secret-token
# Run 注册表持久化路径
AGENTKIT_INTERNAL_API_REGISTRY=output/internal_api/runs.json
# Internal API 允许跨域的来源（逗号分隔）
AGENTKIT_CORS_ORIGINS=http://localhost:5173

# ===== LLM（示例，按 config/llm.example.json 或环境变量注入）=====
AGENTKIT_LLM_PROVIDER=openai
AGENTKIT_LLM_MODEL=gpt-4o-mini
AGENTKIT_LLM_API_KEY=your_api_key
AGENTKIT_LLM_BASE_URL=https://api.openai.com/v1

# ===== Java 平台层 =====
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/agentkit
SPRING_DATASOURCE_USERNAME=agentkit
SPRING_DATASOURCE_PASSWORD=agentkit
AGENTKIT_INTERNAL_API_BASE_URL=http://127.0.0.1:8000

# ===== 前端（vite 以 VITE_ 前缀注入）=====
VITE_AGENTKIT_INTERNAL_API_BASE_URL=http://127.0.0.1:8000
VITE_AGENTKIT_INTERNAL_API_TOKEN=secret-token
