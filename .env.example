# 复制为 .env 后按需修改；.env 已被 .gitignore 忽略

# ===== sale-agent（Python Internal API，:8000）=====
SALE_INTERNAL_API_HOST=127.0.0.1
SALE_INTERNAL_API_PORT=8000
# 留空表示不鉴权；生产环境务必设置，并与前端代理保持一致
SALE_INTERNAL_API_TOKEN=secret-token
# Run 注册表持久化路径
SALE_INTERNAL_API_REGISTRY=output/internal_api/runs.json
# Internal API 允许跨域的来源（逗号分隔）
SALE_CORS_ORIGINS=http://localhost:5173

# ===== LLM（示例，按 config/llm.example.json 或环境变量注入）=====
SALE_LLM_PROVIDER=openai
SALE_LLM_MODEL=gpt-4o-mini
SALE_LLM_API_KEY=your_api_key
SALE_LLM_BASE_URL=https://api.openai.com/v1

# ===== business-mock（Java 平台层，:8080）=====
SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/sale?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=sale
SPRING_DATASOURCE_PASSWORD=sale_pass
SALE_INTERNAL_API_BASE_URL=http://127.0.0.1:8000

# ===== 前端（vite 以 VITE_ 前缀注入）=====
VITE_SALE_INTERNAL_API_BASE_URL=http://127.0.0.1:8000
VITE_SALE_INTERNAL_API_TOKEN=secret-token
